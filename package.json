{
  "name": "quota-peek",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/desktop.mjs dev",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "prepare:desktop": "node scripts/prepare-desktop.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "source:snapshot": "node scripts/source-snapshot.mjs",
    "desktop:dev": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build --no-bundle && node scripts/package-portable.mjs",
    "desktop:installer": "node scripts/desktop.mjs bundle --ci --no-binary-patching",
    "release:publish": "node scripts/publish-release.mjs",
    "package:portable": "node scripts/package-portable.mjs",
    "package:release": "node scripts/package-release.mjs",
    "test": "node --test tests/*.test.mjs providers/*.test.mjs",
    "test:ui": "node scripts/test-ui.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.17",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
