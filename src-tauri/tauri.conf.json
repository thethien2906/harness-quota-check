{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quota Peek",
  "version": "0.1.0",
  "identifier": "com.quotapeek.desktop",
  "build": {
    "beforeDevCommand": "npm.cmd run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main", "title": "Quota Peek", "create": false, "width": 54, "height": 152,
      "resizable": false, "decorations": false, "transparent": true,
      "shadow": false, "alwaysOnTop": true, "skipTaskbar": true,
      "visible": false, "focus": false, "backgroundColor": "#00000000"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true, "targets": ["nsis"],
    "useLocalToolsDir": true,
    "shortDescription": "Quota for your coding tools, at the edge of your screen.",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": ["resources/providers/", "resources/runtime/"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
